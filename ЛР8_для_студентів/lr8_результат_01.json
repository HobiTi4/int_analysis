 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    idx = rng.integers(0, len(F), size=k)      # k випадкових особин (з поверненням)\n    return int(idx[np.argmin(F[idx])])         # індекс тієї, у якої маршрут найкоротший\n",
  "ox": "def ox(p1, p2, i, j):\n    child = p1.copy()                          # відрізок p1[i..j] уже стоїть на своїх місцях\n    used = set(p1[i:j + 1])\n    rest = [g for g in np.roll(p2, -(j + 1)) if g not in used]   # p2 починаючи з j+1 по колу, без уже взятих\n    for s, g in enumerate(rest):\n        child[(j + 1 + s) % len(p1)] = g       # ставимо на вільні місця теж з j+1 по колу\n    return child\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    w = tau[cur, left] ** alpha * eta[cur, left] ** beta     # «привабливість» кожної невідвіданої точки\n    return int(rng.choice(left, p=w / w.sum()))              # вибір з імовірністю, пропорційною привабливості\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    new = (1 - rho) * tau                                    # випаровування\n    for g, L in zip(tours, lens):\n        t = np.concatenate(([0], g, [0]))                    # додаємо вокзал на початок і в кінець\n        new[t[:-1], t[1:]] += 1.0 / L                        # поповнюємо направлені ребра i -> j\n    return new\n"
 },
