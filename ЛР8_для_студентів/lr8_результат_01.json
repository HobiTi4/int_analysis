 ],
 "пояснення": {
  "1": "ГА — випадковий метод: один запуск нічого не доводить, треба ~10 запусків і порівнювати медіани (і бюджет оцінок).",
  "2": "Нечесне порівняння: мурахи отримали в 10 разів більший бюджет. Порівнювати можна лише за однакової кількості оцінок.",
  "4": "Формула з чотирма ребрами годиться лише для симетричної матриці; у несиметричній розворот змінює напрям усіх ребер відрізка.",
  "5": "Якщо d = 0 замінити на нескінченність, то η = 0 і мураха ніколи не піде в точку, яка стоїть поруч (найкращий вибір). Треба ділити на 1 м.",
  "7": "Виграш 3 % коштує в сотні-тисячі разів більше часу; для мобільного застосунку важлива швидкість, тож краще 2-opt (або гібрид). Та й одне місто — не доказ."
 },
 "звіт": {
  "q1_ga_vs_lr5": "Медіана ГА 22963 м — на -1.8 % від 2-opt ЛР5 (23390 м); найкращий запуск 22004 м, найгірший 24322 м. ГА шукає по всьому простору маршрутів і не застрягає в одному локальному оптимумі, як 2-opt, але розкид між запусками великий.",
  "q2_aco_vs_lr5": "Медіана мурах 22937 м — на -1.9 % від 2-opt ЛР5; найкращий 22518 м, найгірший 23400 м. Мурахи стабільніші за ГА, бо враховують віддаль (η = 1/d) і будують маршрут «розумно», а феромон запам'ятовує вдалі ребра.",
  "q3_cost": "2-opt: 1741 оцінок і 0.032 с. ГА: 20000 оцінок, 3.16 с — у ~99 разів довше. Мурахи: 20000 оцінок, 47.0 с — у ~1471 разів довше (дорожче за ГА, бо кожна мураха крок за кроком рахує ймовірності).",
  "q4_ga_vs_aco": "Медіани майже однакові: ГА 22963 м, мурахи 22937 м. Тест Манна — Вітні p = 0.571 > 0,05, тому різниця не доведена — сказати, хто кращий, не можна.",
  "q5_hybrid": "Так: мурахи + 2-opt дає 21931 м — на 6.2 % коротше за ЛР5. 2-opt після метаевристики додає лише 1306 оцінок і 0.028 с, основна ціна — самі 20000 оцінок ГА/мурах.",
  "q6_params": "ГА: популяція 50, турнір 2, еліта 2, мутація 0,1 — у пробних запусках 0,1 дала коротший маршрут, ніж 0,3 (частий розворот руйнує добрі маршрути). Мурахи: 31 мураха, α = 1, β = 2, ρ = 0,5 як у лекції. З β = 0 мурахи не бачать віддалей і ходять майже навмання — маршрут вийшов набагато довшим, ніж з β = 2.",
  "q7_asymmetry": "Розворот відрізка змінює напрям усіх ребер усередині нього. Якщо d(a→b) ≠ d(b→a), то змінюється довжина всіх цих ребер, а не лише чотирьох на краях, тому довжину треба рахувати повністю (у моїй матриці різниця «туди-назад» 0 м, але код має працювати й для несиметричної).",
  "q8_when": "2-opt (з найближчим сусідом) — коли потрібна відповідь миттєво (застосунок, багато запитів): дуже швидко і майже так само добре. ГА — коли є час і хочеться кращий маршрут, а задача «чорна скринька». Мурахи — коли важлива стабільність і відома віддаль між точками, але вони найповільніші. Гібрид (метаевристика + 2-opt) — коли якість важливіша за час: дав найкращий маршрут."
 },
